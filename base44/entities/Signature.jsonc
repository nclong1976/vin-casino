{
  "name": "Signature",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "draw",
        "typed"
      ],
      "default": "draw"
    },
    "content": {
      "type": "string"
    },
    "label": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "content"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}