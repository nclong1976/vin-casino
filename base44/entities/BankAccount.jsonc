{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "bank_name": {
      "type": "string"
    },
    "bank_code": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "account_holder": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "bank_name",
    "account_number",
    "account_holder"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}