{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "project_title": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "method": {
      "type": "string"
    },
    "rate": {
      "type": "number"
    },
    "duration_days": {
      "type": "number"
    },
    "profit": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "signature_type": {
      "type": "string",
      "enum": [
        "draw",
        "typed"
      ]
    },
    "signature_content": {
      "type": "string"
    }
  },
  "required": [
    "project_title",
    "amount"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}