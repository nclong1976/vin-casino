rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app's login (Supabase Auth) is separate from Firebase Auth, so
    // request.auth.uid never matches the app's own user ids and
    // per-document ownership can't be enforced here. This gate only blocks
    // unauthenticated (signed-out) access; any signed-in client (including
    // anonymous sign-in) can read/write, which lets every entity - including
    // the admin dashboard - sync in real time.
    function isAuthenticated() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
