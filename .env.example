# Supabase Configuration
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Supabase — CHỈ dùng ở server (server.ts), KHÔNG có tiền tố VITE_ nên
# không bao giờ lọt vào bundle trình duyệt. Cần cho tính năng cộng lãi hàng
# ngày theo cấp VIP (chạy qua RPC credit_daily_interest_batch, đã bị REVOKE
# khỏi anon/authenticated - chỉ service_role gọi được). Lấy trong Supabase
# Dashboard → Project Settings → API → service_role secret key.
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Telegram — cầu nối CSKH + Nạp/Rút tiền <-> Telegram (server.ts). CHỈ dùng ở
# server, không có tiền tố VITE_. Tạo bot qua @BotFather trên Telegram để lấy
# token; lấy TELEGRAM_CHAT_ID bằng cách thêm bot vào nhóm CSKH, gửi 1 tin
# nhắn bất kỳ rồi gọi https://api.telegram.org/bot<TOKEN>/getUpdates để đọc
# "chat.id". Không cấu hình 2 biến này thì tính năng tự tắt, không chặn
# server khởi động.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890
# Tùy chọn - URL công khai để đăng ký webhook Telegram (VD:
# https://vin-casino-1.onrender.com). Trên Render, RENDER_EXTERNAL_URL đã tự
# có sẵn nên thường KHÔNG cần khai báo biến này.
TELEGRAM_WEBHOOK_URL=
