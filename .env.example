# Supabase Configuration
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# App đã chuyển hẳn sang host tĩnh (GitHub Pages, xem
# .github/workflows/deploy.yml) - KHÔNG còn server Node.js nào chạy nền
# (server.ts/Render đã gỡ bỏ hoàn toàn). Job cộng lãi hàng ngày chạy bằng
# pg_cron thẳng trong Postgres (Supabase Dashboard → Database → Cron Jobs,
# job "credit-daily-interest"); tra cứu thị trường bằng Gemini chuyển sang
# Supabase Edge Function (supabase/functions/market-search, cần secret
# GEMINI_API_KEY riêng trong Edge Function Secrets, không phải ở đây).
# 2 biến VITE_* phía trên cần khai báo lại trong GitHub Actions Secrets
# (Settings → Secrets and variables → Actions) để workflow deploy build
# đúng - Vite "nướng" thẳng vào file JS lúc build, không đọc được lúc chạy.

# Cầu nối CSKH <-> Telegram đã bị gỡ bỏ hoàn toàn (xem migration
# 20260915120000_remove_telegram_bridge.sql) - không còn biến môi trường
# Telegram nào cần cấu hình. CSKH chỉ còn chạy trong Admin Panel/app.

# Thông báo đẩy (Web Push) cho quản trị viên (xem migration
# 20260919090000_admin_push_notifications.sql + supabase/functions/admin-push-send).
# Đây là VAPID PUBLIC key - an toàn để commit/công khai (không phải secret),
# phải khớp đúng VAPID_PUBLIC_KEY cấu hình trong Edge Function Secrets.
