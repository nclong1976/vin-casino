# Firebase Credentials Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Supabase Configuration
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Supabase — CHỈ dùng ở server (server.ts), KHÔNG có tiền tố VITE_ nên
# không bao giờ lọt vào bundle trình duyệt. Cần cho tính năng cộng lãi hàng
# ngày theo cấp VIP (chạy qua RPC credit_daily_interest_batch, đã bị REVOKE
# khỏi anon/authenticated - chỉ service_role gọi được). Lấy trong Supabase
# Dashboard → Project Settings → API → service_role secret key.
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
