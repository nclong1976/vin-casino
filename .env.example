# Supabase Configuration
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Supabase — CHỈ dùng ở server (server.ts), KHÔNG có tiền tố VITE_ nên
# không bao giờ lọt vào bundle trình duyệt. Cần cho tính năng cộng lãi hàng
# ngày theo cấp VIP (chạy qua RPC credit_daily_interest_batch, đã bị REVOKE
# khỏi anon/authenticated - chỉ service_role gọi được). Lấy trong Supabase
# Dashboard → Project Settings → API → service_role secret key.
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_secret_key_here

# Cầu nối CSKH <-> Telegram KHÔNG còn cấu hình ở đây nữa - đã chuyển sang
# Supabase Edge Functions (supabase/functions/telegram-cskh-outbound,
# telegram-webhook), cấu hình TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID/
# TELEGRAM_WEBHOOK_SECRET làm Edge Function secrets trong Supabase Dashboard
# (Project Settings → Edge Functions → Secrets), không phải biến môi trường
# của server.ts/Render. Duyệt Nạp/Rút qua Telegram đã bị gỡ bỏ hoàn toàn -
# chỉ còn duyệt trong Admin Panel.
