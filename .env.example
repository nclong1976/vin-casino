# Supabase Configuration
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Job cộng lãi hàng ngày theo cấp VIP KHÔNG còn chạy ở server.ts/Render nữa
# - đã chuyển sang pg_cron chạy thẳng trong Postgres (Supabase Dashboard →
# Database → Cron Jobs, job "credit-daily-interest"). SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY không còn cần thiết cho server.ts/Render nữa.

# Cầu nối CSKH <-> Telegram KHÔNG còn cấu hình ở đây nữa - đã chuyển sang
# Supabase Edge Functions (supabase/functions/telegram-cskh-outbound,
# telegram-webhook), cấu hình TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID/
# TELEGRAM_WEBHOOK_SECRET làm Edge Function secrets trong Supabase Dashboard
# (Project Settings → Edge Functions → Secrets), không phải biến môi trường
# của server.ts/Render. Duyệt Nạp/Rút qua Telegram đã bị gỡ bỏ hoàn toàn -
# chỉ còn duyệt trong Admin Panel.
